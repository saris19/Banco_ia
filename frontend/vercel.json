{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://banco-proyectos-grado-api.onrender.com/api/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://banco-proyectos-grado-api.onrender.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://banco-proyectos-grado-api.onrender.com/openapi.json"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
      ]
    }
  ]
}
